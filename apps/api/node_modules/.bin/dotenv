#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/Users/regi/Developments/MONOREPO/fahrul-store/node_modules/.pnpm/dotenv@18.0.1/node_modules/dotenv/node_modules:/Users/regi/Developments/MONOREPO/fahrul-store/node_modules/.pnpm/dotenv@18.0.1/node_modules:/Users/regi/Developments/MONOREPO/fahrul-store/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/Users/regi/Developments/MONOREPO/fahrul-store/node_modules/.pnpm/dotenv@18.0.1/node_modules/dotenv/node_modules:/Users/regi/Developments/MONOREPO/fahrul-store/node_modules/.pnpm/dotenv@18.0.1/node_modules:/Users/regi/Developments/MONOREPO/fahrul-store/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../dotenv/dist/index.cjs" "$@"
else
  exec node  "$basedir/../dotenv/dist/index.cjs" "$@"
fi
